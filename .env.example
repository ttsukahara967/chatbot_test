# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chatbot

# Embedding model (dimension must match the vector column in the DB)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# Generation model (Hugging Face causal LM)
# Instruction-tuned Japanese model (1.8B params) - needs ~10-12GB allocated to
# Docker Desktop (Settings > Resources > Memory) even loaded in fp16
GENERATION_MODEL=llm-jp/llm-jp-3-1.8b-instruct

RAG_TOP_K=3
MAX_NEW_TOKENS=200

CORS_ORIGINS=http://localhost:3000
