# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chatbot

# Embedding model (dimension must match the vector column in the DB)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# Generation model (Hugging Face causal LM)
# Uses a Japanese SentencePiece tokenizer (requires sentencepiece in backend/requirements.txt)
GENERATION_MODEL=rinna/japanese-gpt2-small

RAG_TOP_K=3
MAX_NEW_TOKENS=200

CORS_ORIGINS=http://localhost:3000
